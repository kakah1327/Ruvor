# Ambiente local. Copie para .env e rode `docker compose up` na raiz.
# O docker compose le este arquivo automaticamente; nada precisa ser exportado no shell.
# Os valores abaixo funcionam como estao — nao ha segredo real aqui.

RUVOR_SECRET_KEY=desenvolvimento-local-nao-usar-em-producao
RUVOR_DEBUG=true
RUVOR_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Host e porta sao os da rede interna do compose, nao do hospedeiro.
RUVOR_DB_HOST=postgres
RUVOR_DB_PORT=5432
RUVOR_DB_NAME=ruvor
RUVOR_DB_USER=ruvor
RUVOR_DB_PASSWORD=ruvor-local

RUVOR_REDIS_URL=redis://redis:6379/0

# Portas publicadas no hospedeiro. 5173 nao e o padrao do frontend: pertence a
# outro projeto desta maquina.
RUVOR_PORT_WEB=8000
RUVOR_PORT_FRONTEND=5273
RUVOR_PORT_POSTGRES=55432
RUVOR_PORT_REDIS=56379

# Agenda do Celery Beat (servico `beat`), em cron de cinco campos -- minuto, hora, dia do
# mes, mes, dia da semana --, no fuso de Sao Paulo. Os valores abaixo sao os padroes do
# `backend/config/settings.py`: apagar a linha, ou deixa-la vazia, da no mesmo.
# O catalogo de acoes, semanal:
RUVOR_BEAT_ASSETS_CRON=0 7 * * 1
# Os precos, de segunda a sexta -- e, encadeado a eles, o recalculo do risco:
RUVOR_BEAT_PRICES_CRON=30 19 * * 1-5
# Os fundamentos, semanal -- a coleta da CVM, as segundas, e, encadeado a ela, o calculo
# dos indicadores:
RUVOR_BEAT_FUNDAMENTALS_CRON=0 8 * * 1
# Os comunicados da CVM (fatos relevantes, comunicados e avisos), de segunda a sexta:
RUVOR_BEAT_DISCLOSURES_CRON=0 20 * * 1-5
