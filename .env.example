# Ambiente local. Copie para .env e rode `docker compose up` na raiz.
# O docker compose le este arquivo automaticamente; nada precisa ser exportado no shell.
# Os valores abaixo funcionam como estao — nao ha segredo real aqui.

RUVOR_SECRET_KEY=desenvolvimento-local-nao-usar-em-producao
RUVOR_DEBUG=true
RUVOR_ALLOWED_HOSTS=localhost,127.0.0.1,web

# Host e porta sao os da rede interna do compose, nao do hospedeiro.
RUVOR_DB_HOST=postgres
RUVOR_DB_PORT=5432
RUVOR_DB_NAME=ruvor
RUVOR_DB_USER=ruvor
RUVOR_DB_PASSWORD=ruvor-local

RUVOR_REDIS_URL=redis://redis:6379/0

# Cache do Django (o contador do bloqueio de entrada). Banco 1 do Redis, de proposito: o 0 e
# o broker e os resultados do Celery, e o clear() do cache do Django apaga o banco inteiro.
RUVOR_CACHE_URL=redis://redis:6379/1

# Cookies com `Secure` (so com HTTPS; o ambiente local e HTTP) e as origens confiaveis do
# CSRF, separadas por virgula, com esquema (https://exemplo.com). Vazias no ambiente local.
RUVOR_SECURE_COOKIES=false
RUVOR_CSRF_TRUSTED_ORIGINS=

# Portas publicadas no hospedeiro. 5173 nao e o padrao do frontend: pertence a
# outro projeto desta maquina.
RUVOR_PORT_WEB=8000
RUVOR_PORT_FRONTEND=5273
RUVOR_PORT_POSTGRES=55432
RUVOR_PORT_REDIS=56379

# Agenda do Celery Beat (servico `beat`), em cron de cinco campos -- minuto, hora, dia do
# mes, mes, dia da semana --, no fuso de Sao Paulo. Os valores abaixo sao os padroes do
# `backend/config/settings.py`: apagar a linha, ou deixa-la vazia, da no mesmo.
# O catalogo de acoes, semanal:
RUVOR_BEAT_ASSETS_CRON=0 7 * * 1
# Os precos, de segunda a sexta -- e, encadeado a eles, o recalculo do risco:
RUVOR_BEAT_PRICES_CRON=30 19 * * 1-5
# Os fundamentos, semanal -- a coleta da CVM, as segundas, e, encadeado a ela, o calculo
# dos indicadores:
RUVOR_BEAT_FUNDAMENTALS_CRON=0 8 * * 1
# Os comunicados da CVM (fatos relevantes, comunicados e avisos), de segunda a sexta:
RUVOR_BEAT_DISCLOSURES_CRON=0 20 * * 1-5

# O pedido de calculo sob demanda. Os valores abaixo sao os padroes do
# `backend/config/settings.py`: apagar a linha, ou deixa-la vazia, da no mesmo.
# Quantos pedidos abertos, no total, antes de o POST responder 429:
RUVOR_ON_DEMAND_MAX=3
# Minutos depois dos quais um pedido aberto e tratado como fechado (expirado):
RUVOR_ON_DEMAND_TIMEOUT_MIN=30
# Minutos depois dos quais uma execucao de risco `running` e fechada pela varredura. Nao pode
# ser menor que RUVOR_ON_DEMAND_TIMEOUT_MIN: baixar esta abaixo daquela, ou subir aquela acima
# desta, derruba a web, o worker e o beat na carga das configuracoes.
RUVOR_RISK_STALE_AFTER_MIN=360

# O pedido de risco de carteira. Os valores abaixo sao os padroes do
# `backend/config/settings.py`: apagar a linha, ou deixa-la vazia, da no mesmo.
# Quantas execucoes de carteira em andamento, no total, antes de o POST responder 429:
RUVOR_PORTFOLIO_COMPUTE_MAX=2
# Minutos depois dos quais uma execucao de carteira em andamento deixa de contar como tal:
RUVOR_PORTFOLIO_TIMEOUT_MIN=60

# A taxa da API, no formato do DRF (<n>/<s|min|hour|day>). Os padroes sao os do
# `backend/config/settings.py`: apagar a linha, ou deixa-la vazia, da no mesmo.
# Por chave de API e por usuario logado, 600/min:
# RUVOR_THROTTLE_API_KEY=600/min
# RUVOR_THROTTLE_USER=600/min
# Por IP, sem login, 60/min. **Em dev, suba este valor:** todo pedido do navegador chega a
# `web` com o IP do conteiner `frontend`, e uma pagina de ativo sao cinco GET -- 60 por
# minuto, divididos por todo mundo no site local, dao 429 em uso normal.
# RUVOR_THROTTLE_ANON=6000/min
